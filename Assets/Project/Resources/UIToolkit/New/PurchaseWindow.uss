.purchase-window-template-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.purchase-window-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.purchase-window-overlay--visible {
    display: flex;
}

.purchase-window-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(9, 5, 22, 0.84);
}

.purchase-window-dialog {
    width: 82%;
    max-width: 820px;
    height: 78%;
    min-height: 660px;
    max-height: 1120px;
    padding: 24px;
    align-items: stretch;
    background-image: resource("UI/new/BorderFrame_Round03");
    -unity-background-image-tint-color: rgb(69, 58, 105);
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
}

.purchase-window-header {
    height: 90px;
    min-height: 90px;
    align-items: center;
    justify-content: center;
}

.purchase-window-title,
.purchase-window-column-title,
.purchase-window-unit-name,
.purchase-window-price-label,
.purchase-window-close,
.purchase-window-footer-close {
    color: rgb(255, 255, 255);
    -unity-font-definition: resource("Fonts/Lilita One Regular");
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgb(20, 12, 38);
    -unity-text-outline-width: 2px;
}

.purchase-window-title {
    width: 100%;
    height: 100%;
    font-size: 52px;
    color: rgb(255, 232, 145);
}

.purchase-window-close {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 72px;
    height: 72px;
    padding: 0;
    font-size: 52px;
    background-color: rgb(210, 62, 70);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.purchase-window-column-headers {
    height: 64px;
    min-height: 64px;
    flex-direction: row;
}

.purchase-window-column-title {
    flex-grow: 1;
    height: 58px;
    font-size: 30px;
    color: rgb(205, 188, 235);
    background-color: rgba(40, 31, 73, 0.72);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.purchase-window-column-title--left {
    margin-right: 7px;
}

.purchase-window-column-title--right {
    margin-left: 7px;
}

.purchase-window-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.purchase-window-rows {
    flex-grow: 1;
}

.purchase-window-row {
    height: 205px;
    min-height: 205px;
    flex-shrink: 0;
    flex-direction: row;
}

.purchase-option-host,
.purchase-option-placeholder {
    flex-grow: 1;
    flex-basis: 0;
    height: 195px;
    margin: 7px;
}

.purchase-window-card {
    width: 100%;
    height: 100%;
    padding: 0;
    align-items: center;
    background-color: rgb(48, 41, 76);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(105, 91, 154);
    border-right-color: rgb(105, 91, 154);
    border-top-color: rgb(105, 91, 154);
    border-bottom-color: rgb(105, 91, 154);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

.purchase-window-card:hover {
    -unity-background-image-tint-color: rgb(225, 225, 255);
    border-left-color: rgb(160, 137, 220);
    border-right-color: rgb(160, 137, 220);
    border-top-color: rgb(160, 137, 220);
    border-bottom-color: rgb(160, 137, 220);
}

.purchase-window-card:active {
    scale: 0.97 0.97;
}

.purchase-window-card:disabled {
    opacity: 0.42;
}

.purchase-window-unit-icon {
    width: 112px;
    height: 112px;
    -unity-background-scale-mode: scale-to-fit;
}

.purchase-window-unit-name {
    width: 100%;
    height: 34px;
    font-size: 28px;
}

.purchase-window-price {
    width: 100%;
    height: 48px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-image: resource("UI/new/ItemFrame01_Single_Blue");
    -unity-slice-left: 15;
    -unity-slice-top: 15;
    -unity-slice-right: 15;
    -unity-slice-bottom: 15;
}

.purchase-window-price--gems {
    background-image: resource("UI/new/ItemFrame01_Single_Yellow");
}

.purchase-window-currency {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    background-image: resource("UI/new/Icons/Icon_Gold");
    -unity-background-scale-mode: scale-to-fit;
}

.purchase-window-currency--gems {
    background-image: resource("UI/new/Icons/Icon_Gem03_Diamond_Purple 1");
}

.purchase-window-price-label {
    height: 44px;
    font-size: 30px;
}

.purchase-window-footer-close {
    height: 76px;
    min-height: 76px;
    margin-top: 14px;
    padding: 0;
    font-size: 36px;
    background-image: resource("UI/new/ItemFrame01_Single_Blue");
    -unity-slice-left: 15;
    -unity-slice-top: 15;
    -unity-slice-right: 15;
    -unity-slice-bottom: 15;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
