<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Resources/UIToolkit/New/PurchaseWindow.uss?fileID=11400000&amp;guid=1e6d40d4bbd44736a0267017630ba408&amp;type=3#PurchaseWindow"/>
    <ui:VisualElement name="PurchaseWindowRoot" class="purchase-window-overlay">
        <ui:VisualElement class="purchase-window-scrim"/>
        <ui:VisualElement class="purchase-window-dialog" style="display: flex;">
            <ui:VisualElement class="purchase-window-header">
                <ui:Label text="purchase.title" class="purchase-window-title"/>
                <ui:Button name="PurchaseCloseButton" text="×" class="purchase-window-close"/>
            </ui:VisualElement>
            <ui:VisualElement class="purchase-window-column-headers">
                <ui:Label text="purchase.towers" class="purchase-window-column-title purchase-window-column-title--left"/>
                <ui:Label text="purchase.generators" class="purchase-window-column-title purchase-window-column-title--right"/>
            </ui:VisualElement>
            <ui:ScrollView name="PurchaseScrollView" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="purchase-window-scroll">
                <ui:VisualElement name="PurchaseRows" class="purchase-window-rows"/>
            </ui:ScrollView>
            <ui:Button name="PurchaseFooterCloseButton" text="common.close" class="purchase-window-footer-close"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
