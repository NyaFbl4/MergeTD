<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Resources/UIToolkit/ShopUI.uss?fileID=11400000&amp;guid=2804ea254394429283042a052bab0302&amp;type=3#ShopUI"/>
    <ui:VisualElement name="ShopSection" style="display: flex; position: absolute; top: 0; bottom: -75px; flex-grow: 1; width: 100%; min-height: 0; align-items: center; padding-top: 10px; padding-bottom: 0;">
        <ui:VisualElement name="ShopContent" style="display: flex; flex-grow: 1; width: 950px; min-width: 950px; max-width: 950px; min-height: 0; align-items: center; background-image: none; -unity-background-scale-mode: stretch-to-fill;">
            <ui:Label text="shop.title" name="TitleLabel" style="width: 700px; height: 76px; color: rgb(255, 255, 255); font-size: 48px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; -unity-text-align: middle-center; display: none;"/>
            <ui:ScrollView name="ScrollView" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; width: 950px; min-height: 0;">
                <ui:VisualElement name="OfferPanel" style="flex-grow: 1;">
                    <ui:Label text="Предложения" name="OfferLabel" style="font-size: 75px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: upper-center;"/>
                    <ui:VisualElement name="OfferContainer" style="flex-grow: 1; align-self: stretch; justify-content: center; align-items: center;"/>
                </ui:VisualElement>
                <ui:VisualElement name="EnergyOffersPanel" style="flex-grow: 1;">
                    <ui:Label text="shop.energy_tab" name="EnergySectionLabel" style="font-size: 75px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: upper-center;"/>
                    <ui:VisualElement name="EnergyContainer" style="width: 720px; min-width: 720px; max-width: 720px; align-self: center; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; align-content: flex-start;"/>
                </ui:VisualElement>
                <ui:VisualElement name="AcceleratorOffersPanel" style="flex-grow: 1;">
                    <ui:Label text="shop.accelerators.title" name="AcceleratorSectionLabel" style="font-size: 75px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: upper-center;"/>
                    <ui:VisualElement name="AcceleratorContainer" style="width: 720px; min-width: 720px; max-width: 720px; align-self: center; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; align-content: flex-start;"/>
                </ui:VisualElement>
                <ui:VisualElement name="GemPanel" style="flex-grow: 1;">
                    <ui:Label text="Гемы" name="GemLabel" style="font-size: 75px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: upper-center;"/>
                    <ui:VisualElement name="GemContainer" class="shop-offer-grid" style="width: 720px; min-width: 720px; max-width: 720px; align-self: center; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; align-content: flex-start;"/>
                </ui:VisualElement>
                <ui:VisualElement name="GoldPanel" style="flex-grow: 1;">
                    <ui:Label text="shop.gold_tab" name="GoldSectionLabel" style="font-size: 75px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: upper-center;"/>
                    <ui:VisualElement name="GoldContainer" class="shop-offer-grid" style="width: 720px; min-width: 720px; max-width: 720px; align-self: center; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; align-content: flex-start;"/>
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:Label name="EmptyLabel" class="shop-empty-label"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
