<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Layout" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; min-width: 100%; min-height: 100%; align-items: center; justify-content: center; background-color: rgba(12, 8, 28, 0); -unity-background-image-tint-color: rgb(255, 255, 255);">
        <ui:VisualElement name="SpellInfoPanel" style="position: relative; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); background-color: rgba(188, 188, 188, 0); -unity-slice-left: 24; -unity-slice-top: 24; -unity-slice-right: 24; -unity-slice-bottom: 24; -unity-background-image-tint-color: rgb(69, 61, 112); align-items: center; width: 800px; min-width: 800px; max-width: 800px; min-height: 860px; max-height: 1040px; padding-top: 34px; padding-right: 35px; padding-bottom: 28px; padding-left: 35px; justify-content: flex-start;">
            <ui:VisualElement name="Header" style="width: 100%; min-width: 100%; max-width: 100%; height: 190px; min-height: 190px; max-height: 190px; flex-direction: row; align-items: center; padding-right: 80px;">
                <ui:VisualElement name="IconSpellPanel" style="width: 180px; min-width: 180px; max-width: 180px; height: 180px; min-height: 180px; max-height: 180px; background-image: resource(&quot;UI/new/ItemFrame01_Single_Red&quot;); -unity-background-scale-mode: stretch-to-fill; align-items: center; justify-content: center;">
                    <ui:VisualElement name="IconSpell" style="width: 135px; height: 135px; min-height: 135px; max-height: 135px; min-width: 135px; max-width: 135px; background-image: resource(&quot;UI/new/Icons/Spells/EmpPulse&quot;); -unity-background-scale-mode: scale-to-fit;"/>
                </ui:VisualElement>
                <ui:VisualElement name="SpellDescriptionPanel" style="flex-grow: 1; height: 100%; min-height: 100%; max-height: 100%; justify-content: center; margin-left: 20px;">
                    <ui:Label text="Ледяная буря" name="SpellNameLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 38px; height: 62px; min-height: 62px; max-height: 62px; -unity-font-style: bold; -unity-text-align: middle-left; white-space: normal;"/>
                    <ui:Label text="Уровень 1 / 4" name="SpellLevelLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 26px; height: 45px; min-height: 45px; max-height: 45px; color: rgb(255, 220, 72); -unity-font-style: bold; -unity-text-align: middle-left;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Описание способности" name="SpellDescriptionLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 100%; min-width: 100%; max-width: 100%; min-height: 105px; max-height: 210px; font-size: 28px; color: rgb(211, 205, 235); -unity-text-align: upper-left; white-space: normal; margin-top: 18px;"/>
            <ui:Label text="Перезарядка 5 с · мана 6" name="CooldownLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 100%; min-width: 100%; max-width: 100%; height: 48px; min-height: 48px; max-height: 48px; font-size: 25px; color: rgb(166, 157, 196); -unity-font-style: bold; -unity-text-align: middle-left;"/>
            <ui:VisualElement name="StatsInfoPanel" style="width: 100%; min-width: 100%; max-width: 100%; min-height: 225px; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); -unity-slice-left: 25; -unity-slice-top: 25; -unity-slice-right: 25; -unity-slice-bottom: 25; -unity-background-image-tint-color: rgb(35, 29, 62); margin-top: 10px; margin-bottom: 18px; padding-top: 22px; padding-right: 26px; padding-bottom: 22px; padding-left: 26px;">
                <ui:VisualElement name="UpgradeLevelRow" style="width: 100%; min-width: 100%; max-width: 100%; height: 44px; min-height: 44px; max-height: 44px; flex-direction: row; align-items: center;">
                    <ui:Label text="УРОВЕНЬ 1 / 4" name="UpgradeLevelLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 25px; color: rgb(170, 160, 201); -unity-font-style: bold; -unity-text-align: middle-left;"/>
                    <ui:Label text="→ 2" name="NextLevelLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 25px; color: rgb(116, 255, 70); -unity-font-style: bold; -unity-text-align: middle-left; margin-left: 10px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="UpgradeDivider" style="width: 100%; min-width: 100%; max-width: 100%; height: 2px; min-height: 2px; max-height: 2px; background-color: rgba(135, 121, 172, 0.28); margin-top: 4px; margin-bottom: 12px;"/>
                <ui:VisualElement name="UpgradeTitleRow" style="width: 100%; min-width: 100%; max-width: 100%; min-height: 44px; flex-direction: row; align-items: center;">
                    <ui:Label text="Усиление" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 190px; min-width: 190px; max-width: 190px; font-size: 25px; color: rgb(170, 160, 201); -unity-text-align: middle-left;"/>
                    <ui:Label text="Глубокая заморозка" name="UpgradeTitleLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); flex-grow: 1; font-size: 25px; color: rgb(116, 255, 70); -unity-font-style: bold; -unity-text-align: middle-right; white-space: normal;"/>
                </ui:VisualElement>
                <ui:Label text="Сила замедления увеличивается до 65%." name="UpgradeDescriptionLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 100%; min-width: 100%; max-width: 100%; min-height: 72px; font-size: 24px; color: rgb(235, 231, 247); -unity-text-align: upper-left; white-space: normal; margin-top: 8px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonsPanel" style="width: 100%; min-width: 100%; max-width: 100%; height: 145px; min-height: 145px; max-height: 145px; flex-direction: row; justify-content: space-between;">
                <ui:Button text="" name="UpgradeButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); background-image: resource(&quot;UI/new/Buttons/Button01_175_Yellow&quot;); background-color: rgba(56, 56, 56, 0); width: 345px; min-width: 345px; max-width: 345px; height: 140px; min-height: 140px; max-height: 140px; -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-items: center; justify-content: center;">
                    <ui:Label text="Прокачать" name="UpgradeButtonLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 100%; height: 55px; min-height: 55px; max-height: 55px; font-size: 30px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;"/>
                    <ui:VisualElement name="UpgradePricePanel" style="height: 50px; min-height: 50px; max-height: 50px; flex-direction: row; align-items: center; justify-content: center;">
                        <ui:VisualElement name="UpgradeCurrencyIcon" style="width: 42px; min-width: 42px; max-width: 42px; height: 42px; min-height: 42px; max-height: 42px; background-image: resource(&quot;UI/new/Icons/Icon_Gem03_Diamond_Purple 1&quot;); -unity-background-scale-mode: scale-to-fit;"/>
                        <ui:Label text="200" name="UpgradePriceLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 28px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-left; margin-left: 4px;"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button text="" name="SetSpellButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); background-image: resource(&quot;UI/new/Buttons/Button01_175_Green&quot;); background-color: rgba(56, 56, 56, 0); width: 345px; min-width: 345px; max-width: 345px; height: 140px; min-height: 140px; max-height: 140px; -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-items: center; justify-content: center;">
                    <ui:Label text="Убрать" name="SetSpellButtonLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 100%; height: 100%; font-size: 32px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button text="&#10;" name="CloseButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); background-image: resource(&quot;UI/new/Buttons/Button_Square03_White&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; width: 100px; min-width: 100px; max-width: 100px; height: 100px; min-height: 100px; max-height: 100px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-background-image-tint-color: rgb(241, 69, 69); position: absolute; top: -20px; left: 710px;">
                <ui:VisualElement name="CloseIcon" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icons/Icon_PictoIcon_Close&quot;); width: 75px; min-width: 75px; max-width: 75px; height: 75px; min-height: 75px; max-height: 75px;"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
