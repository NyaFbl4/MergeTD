<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TowerPanel" style="flex-grow: 0; flex-shrink: 0; width: 600px; height: 200px; min-width: 600px; max-width: 600px; min-height: 200px; max-height: 200px; background-image: resource(&quot;UI/new/CardFrame08_White&quot;); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 40px; align-items: center; align-self: center; -unity-background-image-tint-color: rgb(131, 189, 245); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; flex-direction: row;">
        <ui:VisualElement name="SelectedElement" style="flex-grow: 1; position: absolute; width: 645px; height: 240px; min-width: 645px; max-width: 645px; min-height: 240px; max-height: 240px; top: -20px; left: -22px; background-image: resource(&quot;UI/new/ListFrame02_f&quot;); -unity-slice-left: 50; -unity-slice-top: 50; -unity-slice-right: 50; -unity-slice-bottom: 50; -unity-background-scale-mode: stretch-to-fill; display: none;"/>
        <ui:VisualElement name="TowerIconPanel" style="flex-grow: 1; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); height: 100px; min-height: 100px; max-height: 100px; width: 100px; min-width: 100px; max-width: 100px; -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; align-items: center; justify-content: center;">
            <ui:VisualElement name="TowerIcon" style="flex-grow: 1; width: 80px; height: 80px; min-height: 80px; max-height: 80px; min-width: 80px; max-width: 80px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="DescriptionPanel" style="flex-grow: 1; margin-left: 5px;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; height: 43px; min-height: 43px; max-height: 43px;">
                <ui:Label text="Огненный шар  " name="SpellNameLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 25px; -unity-font-style: bold; height: 45px; white-space: normal; -unity-text-align: middle-center;"/>
                <ui:Label text="Уровень 2" name="SpellLevelLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 25px; color: rgb(255, 252, 0); height: 45px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
            <ui:Label text="Взрыв взрыв взрыв" name="SpellDescriptionLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 20px; white-space: normal; height: 90px; min-height: 90px; max-height: 90px;"/>
            <ui:Label text="КД 4 секунд, стоит 6 маны" name="SpellCooldownLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 25px; color: rgb(111, 0, 255); white-space: nowrap; -unity-text-auto-size: best-fit 14px 25px; -unity-text-align: upper-left;"/>
        </ui:VisualElement>
        <ui:Button text="" name="SetSpellButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 150px; min-width: 150px; max-width: 150px; height: 60px; min-height: 60px; max-height: 60px; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; flex-direction: row; align-self: center; -unity-background-image-tint-color: rgb(237, 243, 61);">
            <ui:Label text="ВЫБРАНО" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 25px; width: 142px; height: 52px; min-width: 100%; top: -9px; left: -9px;"/>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
