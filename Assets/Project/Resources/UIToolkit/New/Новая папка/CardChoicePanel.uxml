<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Button text="" name="RewardChoicePanel" style="background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); background-color: rgba(188, 188, 188, 0); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; -unity-background-image-tint-color: rgb(69, 70, 130); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-items: center; width: 320px; min-width: 320px; max-width: 320px; height: 400px; min-height: 400px; max-height: 400px; margin-left: 15px; margin-right: 15px;">
        <ui:Label text="Редкая" name="RewardChoiceRareLabel" style="font-size: 25px; margin-bottom: 25px; width: 100%; min-width: 100%; max-width: 100%;"/>
        <ui:Label text="Дальнобойность" name="RewardChoiceNameLabel" style="font-size: 25px; -unity-text-auto-size: best-fit 10px 100px; width: 100%; min-width: 100%; max-width: 100%;"/>
        <ui:Label text="Башня 3ЛВЛ" name="RewardChoiceDescriptionLabel" style="font-size: 25px; width: 100%; min-width: 100%; max-width: 100%; margin-bottom: 25px;"/>
