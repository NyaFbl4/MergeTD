<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="ArmyPanel" src="project://database/Assets/Project/Resources/UIToolkit/New/ArmyPanel.uxml?fileID=9197481963319205126&amp;guid=94e86a50830bfa2479e01b60fd900afe&amp;type=3#ArmyPanel"/>
    <ui:Template name="InBattlePanelTemplate" src="project://database/Assets/Project/Resources/UIToolkit/New/InBattlePanel.uxml?fileID=9197481963319205126&amp;guid=34cfc351c81e1c54b825581bca0f511d&amp;type=3#InBattlePanel"/>
    <ui:Template name="SpellsPanelTemplate" src="project://database/Assets/Project/Resources/UIToolkit/New/SpellsPanel.uxml?fileID=9197481963319205126&amp;guid=f58d8253033568441930b1764a916116&amp;type=3#SpellsPanel"/>
    <ui:VisualElement name="Layout" style="flex-grow: 1;">
        <ui:VisualElement name="Background" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: resource(&quot;exec-3857d5d4-a61d-4425-901c-e1216a7ac466&quot;);"/>
        <ui:VisualElement name="HeaderPanel" style="flex-grow: 1; width: 100%; min-width: 100%; max-width: 100%; height: 150px; min-height: 150px; max-height: 150px; justify-content: flex-end; flex-direction: row-reverse; align-self: center; align-items: center;">
            <ui:VisualElement name="GoldPanel" style="flex-grow: 1; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); height: 80px; min-height: 80px; max-height: 80px; width: 250px; min-width: 250px; max-width: 250px; -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(120, 108, 108); margin-left: 50px; flex-direction: row;">
                <ui:VisualElement name="IconGold" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icons/Icon_Gold&quot;); width: 100px; height: 100px; min-height: 100px; max-height: 100px; min-width: 100px; max-width: 100px; top: -10px; left: -40px;"/>
                <ui:Label text="500" name="GoldLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 177px; top: auto; left: -35px; -unity-text-align: middle-left; font-size: 50px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="GemPanel" style="flex-grow: 1; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); height: 80px; min-height: 80px; max-height: 80px; width: 250px; min-width: 250px; max-width: 250px; -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(120, 108, 108); margin-left: 50px; flex-direction: row;">
                <ui:VisualElement name="IconGem" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icons/Icon_Gem03_Diamond_Purple 1&quot;); width: 100px; height: 100px; min-height: 100px; max-height: 100px; min-width: 100px; max-width: 100px; top: -10px; left: -40px; -unity-background-scale-mode: scale-to-fit;"/>
                <ui:Label text="500" name="GemLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 177px; top: auto; left: -35px; -unity-text-align: middle-left; font-size: 50px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Body" style="flex-grow: 1;">
            <ui:VisualElement name="MainPanel" style="flex-grow: 1; justify-content: flex-end; align-items: stretch; align-content: stretch;">
                <ui:VisualElement name="ContentHost" style="flex-grow: 1; width: 100%; height: 100%; align-self: center; justify-content: center;">
                    <ui:Instance template="ArmyPanel" name="ArmyPanel" style="display: flex; flex-grow: 1; width: 100%; height: 100%;"/>
                    <ui:Instance template="InBattlePanelTemplate" name="InBattleContent" style="flex-grow: 1; width: 100%; height: 100%; display: none;"/>
                    <ui:Instance template="SpellsPanelTemplate" name="SpellsPanel" style="flex-grow: 1; width: 100%; height: 100%; display: none;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ButtonsPanel" style="flex-grow: 1; bottom: 0; width: 100%; min-width: 100%; max-width: 100%; height: 300px; min-height: 300px; max-height: 300px; align-items: flex-end; justify-content: center; flex-direction: row; align-self: flex-end;">
            <ui:Button text="" name="ShopButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 175px; min-width: 175px; max-width: 175px; height: 250px; min-height: 250px; aspect-ratio: 100; max-height: 250px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&quot;UI/new/CardFrame08_Single_Blue&quot;); -unity-slice-left: 50; -unity-slice-top: 50; -unity-slice-right: 50; -unity-slice-bottom: 50; background-color: rgba(188, 188, 188, 0); bottom: -33px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 0; margin-left: 0; align-items: center; justify-content: center;">
                <ui:VisualElement name="ButtonIcon" style="flex-grow: 1; width: 100px; height: 100px; min-height: 100px; max-height: 100px; min-width: 100px; max-width: 100px; font-size: 30px; background-image: resource(&quot;UI/new/Icons/Icon_Button_Shop&quot;);"/>
                <ui:Label text="МАГИЗИН" name="ButtonLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 30px; width: 100%;"/>
            </ui:Button>
            <ui:Button text="" name="ArmyButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 175px; min-width: 175px; max-width: 175px; height: 250px; min-height: 250px; aspect-ratio: 100; max-height: 250px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&quot;UI/new/CardFrame08_Single_Blue&quot;); -unity-slice-left: 50; -unity-slice-top: 50; -unity-slice-right: 50; -unity-slice-bottom: 50; background-color: rgba(188, 188, 188, 0); bottom: -33px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 0; margin-left: 0; align-items: center; justify-content: center;">
                <ui:VisualElement name="ButtonIcon" style="flex-grow: 1; width: 100px; height: 100px; min-height: 100px; max-height: 100px; min-width: 100px; max-width: 100px; font-size: 30px; background-image: resource(&quot;UI/new/Icons/Icon_Button_Army&quot;);"/>
                <ui:Label text="АРМИЯ" name="ButtonLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 30px; width: 100%;"/>
            </ui:Button>
            <ui:Button text="" name="BattleButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 225px; min-width: 225px; max-width: 225px; height: 275px; min-height: 275px; aspect-ratio: 100; max-height: 275px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&quot;UI/new/CardFrame08_Single_Purple&quot;); -unity-slice-left: 50; -unity-slice-top: 50; -unity-slice-right: 50; -unity-slice-bottom: 50; background-color: rgba(188, 188, 188, 0); bottom: -33px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 0; margin-left: 0; align-items: center; justify-content: center;">
                <ui:VisualElement name="ButtonIcon" style="flex-grow: 1; width: 150px; height: 150px; min-height: 150px; max-height: 150px; min-width: 150px; max-width: 150px; font-size: 30px; background-image: resource(&quot;UI/new/Icons/Icon_Button_Battle&quot;);"/>
                <ui:Label text="В БОЙ" name="ButtonLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 40px; width: 100%;"/>
            </ui:Button>
            <ui:Button text="" name="SpellsButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 175px; min-width: 175px; max-width: 175px; height: 250px; min-height: 250px; aspect-ratio: 100; max-height: 250px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&quot;UI/new/CardFrame08_Single_Blue&quot;); -unity-slice-left: 50; -unity-slice-top: 50; -unity-slice-right: 50; -unity-slice-bottom: 50; background-color: rgba(188, 188, 188, 0); bottom: -33px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 0; margin-left: 0; align-items: center; justify-content: center;">
                <ui:VisualElement name="ButtonIcon" style="flex-grow: 1; width: 100px; height: 100px; min-height: 100px; max-height: 100px; min-width: 100px; max-width: 100px; font-size: 30px; background-image: resource(&quot;UI/new/Icons/Icon_Button_Spells&quot;);"/>
                <ui:Label text="СПЕЛЫ" name="ButtonLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 30px; width: 100%;"/>
            </ui:Button>
            <ui:Button text="" name="BaseButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 175px; min-width: 175px; max-width: 175px; height: 250px; min-height: 250px; aspect-ratio: 100; max-height: 250px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&quot;UI/new/CardFrame08_Single_Blue&quot;); -unity-slice-left: 50; -unity-slice-top: 50; -unity-slice-right: 50; -unity-slice-bottom: 50; background-color: rgba(188, 188, 188, 0); bottom: -33px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 0; margin-left: 0; align-items: center; justify-content: center;">
                <ui:VisualElement name="ButtonIcon" style="flex-grow: 1; width: 100px; height: 100px; min-height: 100px; max-height: 100px; min-width: 100px; max-width: 100px; font-size: 30px; background-image: resource(&quot;UI/new/Icons/Icon_Button_Base&quot;);"/>
                <ui:Label text="БАЗА" name="ButtonLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 30px; width: 100%;"/>
            </ui:Button>
        </ui:VisualElement>
