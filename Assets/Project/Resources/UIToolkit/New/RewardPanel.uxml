<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="RewardPanel" style="flex-grow: 1; background-image: resource(&quot;UI/new/CardFrame08_White&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; width: 300px; min-width: 300px; max-width: 300px; height: 100px; min-height: 100px; max-height: 100px; flex-direction: row; align-self: center; align-items: center; padding-top: 15px; padding-right: 15px; padding-bottom: 15px; padding-left: 15px; -unity-background-image-tint-color: rgb(255, 255, 255);">
        <ui:VisualElement name="RewardIcon" style="flex-grow: 1; width: 80px; height: 80px; min-height: 80px; max-height: 80px; min-width: 80px; max-width: 80px; background-image: resource(&quot;UI/new/Icon_Gold&quot;); -unity-background-scale-mode: scale-to-fit;"/>
        <ui:Label text="300" name="RewardCountLabel" style="font-size: 50px; width: 192px;"/>
    </ui:VisualElement>
</ui:UXML>
