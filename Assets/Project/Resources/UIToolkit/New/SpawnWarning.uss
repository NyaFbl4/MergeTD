.spawn-warning {
    display: none;
    position: absolute;
    top: 27%;
    left: 18%;
    right: 18%;
    padding: 18px 24px;
    background-color: rgba(35, 15, 9, 0.92);
    color: rgb(255, 211, 110);
    border-width: 2px;
    border-color: rgb(214, 113, 42);
    border-radius: 12px;
    font-size: 42px;
    -unity-font-definition: resource("Fonts/Lilita One Regular");
    -unity-text-align: middle-center;
    white-space: normal;
}
.spawn-warning.spawn-warning-visible {
    display: flex;
}
