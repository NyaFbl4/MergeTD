<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Layout" style="flex-grow: 1;">
        <ui:VisualElement name="Body" style="flex-grow: 1;">
            <ui:VisualElement name="MainPanel" style="flex-grow: 1; justify-content: flex-end; align-items: stretch; align-content: stretch;">
                <ui:VisualElement name="InBattlePanel" style="flex-grow: 1; align-self: auto; align-items: center; width: 100%; height: 100%; min-height: 100%; max-height: 100%; min-width: 100%; max-width: 100%; justify-content: space-between;">
                    <ui:VisualElement name="DailyPanel" style="flex-grow: 1; width: 100%; min-width: 100%; max-width: 100%; align-items: center; justify-content: center; height: 20%; min-height: 20%; max-height: 20%; align-self: center; align-content: center;">
                        <ui:VisualElement name="Panel" style="flex-grow: 1; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; width: 90%; height: 200px; min-height: 200px; max-height: 200px; min-width: 90%; max-width: 90%; -unity-background-image-tint-color: rgba(255, 255, 255, 0.553); -unity-background-scale-mode: stretch-to-fill; background-position-y: center; align-items: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                            <ui:VisualElement name="DailyPanel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); height: 175px; width: 800px; min-width: 800px; max-width: 800px; min-height: 175px; max-height: 175px; flex-direction: column; justify-content: center;">
                                <ui:VisualElement name="Header" style="flex-grow: 1; width: 100%; min-width: 100%; max-width: 100%; height: 75px; min-height: 75px; max-height: 75px; flex-direction: row;">
                                    <ui:Label text="Ежедневные награды" name="QuestHeaderLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-left; font-size: 40px; width: 70%; height: 100%; min-height: 100%; max-height: 100%; left: 57px;"/>
                                    <ui:Button text="ЗАБРАТЬ" name="QuestButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 200px; min-width: 200px; max-width: 200px; height: 70px; min-height: 70px; max-height: 70px; background-image: resource(&quot;UI/new/Buttons/Button01_175_Green&quot;); -unity-slice-left: 30; -unity-slice-top: 30; -unity-slice-right: 30; -unity-slice-bottom: 30; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 30px;"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="Container" style="flex-grow: 1; flex-direction: row; align-items: flex-start; align-self: auto; justify-content: center;">
                                    <ui:VisualElement name="DailyRewardElement" template="DailyRewardElement">
                                        <ui:VisualElement name="DailyRewardElement" style="flex-grow: 1; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; width: 100px; height: 100px; min-height: 100px; max-height: 100px; min-width: 100px; max-width: 100px; margin-top: 0; margin-right: 5px; margin-left: 5px; align-items: center; justify-content: center;">
