                    <ui:VisualElement name="LebelPanel" style="flex-grow: 1; height: 800px; min-height: 800px; max-height: 800px; align-items: stretch; justify-content: center; flex-direction: row; width: 100%; min-width: 100%; max-width: 100%;">
                        <ui:Button text="" name="PrevLevelButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); background-image: resource(&quot;UI/new/Buttons/Button_TaperedLeft_Green&quot;); background-color: rgba(188, 188, 188, 0); -unity-background-scale-mode: scale-to-fit; width: 120px; min-width: 120px; max-width: 120px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-left: 20px;"/>
