                            <ui:VisualElement name="LevelNamePanel" style="flex-grow: 1; width: 400px; height: 100px; min-height: 100px; max-height: 100px; min-width: 400px; max-width: 400px; justify-content: flex-start; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; align-items: center; top: auto; -unity-text-auto-size: none;">
                                <ui:Label text="1 уровень" name="LevelNameLabel" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 50px; -unity-text-auto-size: best-fit 10px 100px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button text="" name="NextLevelButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 120px; min-width: 120px; max-width: 120px; background-image: resource(&quot;UI/new/Buttons/Button_TaperedLeft_Green&quot;); -unity-background-scale-mode: scale-to-fit; background-color: rgba(188, 188, 188, 0); background-repeat: no-repeat no-repeat; -unity-slice-type: tiled; transform-origin: center; rotate: 0 0 0 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; scale: -1 1; margin-right: 20px;"/>
                    </ui:VisualElement>
                    <ui:Button text="В БОЙ" name="PlayButton" style="-unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 300px; min-width: 300px; max-width: 300px; height: 100px; min-height: 100px; max-height: 100px; background-image: resource(&quot;UI/new/Buttons/Button01_175_Yellow&quot;); -unity-slice-scale: 1px; -unity-slice-left: 25; -unity-slice-top: 25; -unity-slice-right: 25; -unity-slice-bottom: 25; background-color: rgba(188, 188, 188, 0); font-size: 50px; margin-top: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
