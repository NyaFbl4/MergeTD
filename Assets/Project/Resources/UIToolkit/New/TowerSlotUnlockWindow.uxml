<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="TowerSlotUnlockWindow" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; display: flex;">
        <ui:VisualElement name="SlotUnlockScrim" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(9, 5, 22, 0.86);"/>
        <ui:VisualElement name="SlotUnlockDialog" style="width: 86%; max-width: 760px; max-height: 94%; padding: 26px; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); -unity-background-image-tint-color: rgb(69, 58, 105); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; align-items: center;">
            <ui:VisualElement name="SlotUnlockHeader" style="min-height: 80px; justify-content: center; padding-right: 64px;">
                <ui:Label name="SlotUnlockTitle" text="Расширение базы" style="color: rgb(255, 232, 145); -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center; -unity-text-outline-color: rgb(20, 12, 38); -unity-text-outline-width: 1px; white-space: normal; flex-shrink: 0; font-size: 42px;"/>
                <ui:Button text="&#10;" name="SlotUnlockClose" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); background-image: resource(&quot;UI/new/Buttons/Button_Square03_White&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; width: 100px; min-width: 100px; max-width: 100px; height: 100px; min-height: 100px; max-height: 100px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-background-image-tint-color: rgb(241, 69, 69); position: absolute; top: -50px; left: 500px;">
                    <ui:VisualElement name="CloseIcon" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icons/Icon_PictoIcon_Close&quot;); width: 75px; min-width: 75px; max-width: 75px; height: 75px; min-height: 75px; max-height: 75px;"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Label name="SlotUnlockOrdinal" text="Дополнительный слот 1 из 5" style="color: rgb(221, 205, 255); -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center; -unity-text-outline-color: rgb(20, 12, 38); -unity-text-outline-width: 1px; white-space: normal; flex-shrink: 0; font-size: 30px; margin-top: 12px;"/>
            <ui:Label name="SlotUnlockDescription" text="Место для башни или генератора. Сохраняется между забегами." style="color: white; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center; -unity-text-outline-color: rgb(20, 12, 38); -unity-text-outline-width: 1px; white-space: normal; flex-shrink: 0; font-size: 27px; margin-top: 18px; margin-bottom: 14px;"/>
            <ui:VisualElement style="flex-direction: row; justify-content: center; align-items: center; margin-top: 10px;">
                <ui:VisualElement name="SlotUnlockGoldIcon" style="width: 52px; height: 52px; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; background-image: resource(&quot;UI/new/Icons/Icon_Gold&quot;);"/>
                <ui:Label name="SlotUnlockPrice" text="Цена: 750 золота" style="color: rgb(255, 232, 145); -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center; -unity-text-outline-color: rgb(20, 12, 38); -unity-text-outline-width: 1px; white-space: normal; flex-shrink: 0; font-size: 36px;"/>
            </ui:VisualElement>
            <ui:Label name="SlotUnlockStatus" text="Слот останется открытым до сброса прогресса." style="color: rgb(181, 236, 182); -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center; -unity-text-outline-color: rgb(20, 12, 38); -unity-text-outline-width: 1px; white-space: normal; flex-shrink: 0; font-size: 25px; min-height: 68px; margin-top: 14px;"/>
            <ui:Label name="SlotUnlockBlockedStatus" text="Не хватает 250 золота" style="color: rgb(181, 236, 182); -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center; -unity-text-outline-color: rgb(20, 12, 38); -unity-text-outline-width: 1px; white-space: normal; flex-shrink: 0; font-size: 25px; min-height: 68px; margin-top: 14px; color: rgb(255, 204, 150); display: none;"/>
            <ui:Button name="SlotUnlockPurchase" text="Открыть за 750" style="color: white; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center; -unity-text-outline-color: rgb(20, 12, 38); -unity-text-outline-width: 1px; white-space: normal; flex-shrink: 0; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; height: 84px; font-size: 32px; margin-top: 10px; background-color: rgba(69, 151, 78, 0); background-image: resource(&quot;UI/new/Buttons/Button01_175_Green&quot;); -unity-slice-left: 25; -unity-slice-top: 25; -unity-slice-right: 25; -unity-slice-bottom: 25; width: 50%;"/>
            <ui:Button name="SlotUnlockPurchaseBlocked" text="Открыть за 750" style="color: white; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center; -unity-text-outline-color: rgb(20, 12, 38); -unity-text-outline-width: 1px; white-space: normal; flex-shrink: 0; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; height: 84px; font-size: 32px; margin-top: 10px; background-color: rgb(69, 151, 78); background-color: rgb(79, 74, 97); opacity: 0.8; display: none;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
