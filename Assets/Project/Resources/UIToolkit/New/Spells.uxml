            <ui:Button text="&#10;" name="CloseButton" style="background-image: resource(&quot;UI/new/Buttons/Button_Square03_White&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; width: 100px; min-width: 100px; max-width: 100px; height: 100px; min-height: 100px; max-height: 100px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-background-image-tint-color: rgb(241, 69, 69); position: absolute; top: -20px; left: 710px;">
                <ui:VisualElement name="CloseIcon" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icons/Icon_PictoIcon_Close&quot;); width: 75px; min-width: 75px; max-width: 75px; height: 75px; min-height: 75px; max-height: 75px;"/>
            </ui:Button>
