<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="BaseUpgradeItem" style="width: 100%; min-height: 172px; margin-top: 15px; margin-bottom: 15px; flex-direction: row; align-items: center; background-image: resource(&quot;UI/new/CardFrame08_White&quot;); -unity-slice-left: 25; -unity-slice-top: 25; -unity-slice-right: 25; -unity-slice-bottom: 25; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; -unity-background-image-tint-color: rgba(26, 53, 123, 0.859);">
        <ui:VisualElement name="UpgradeIcon" picking-mode="Ignore" style="width: 92px; height: 92px; margin-right: 18px; flex-shrink: 0; background-image: resource(&quot;UI/Shopping popup/shield icon&quot;); -unity-background-scale-mode: scale-to-fit;"/>
        <ui:VisualElement name="UpgradeContent" style="flex-grow: 1; flex-shrink: 1; min-width: 0; padding-right: 12px;">
            <ui:VisualElement name="UpgradeTitleRow" style="flex-direction: row; align-items: center; top: -9px;">
                <ui:Label text="upgrade.base_health.title" name="UpgradeTitleLabel" style="color: rgb(136, 55, 250); font-size: 28px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-font-style: bold;"/>
                <ui:Label text="base.upgrade_level_format" name="UpgradeLevelLabel" style="margin-left: 7px; color: rgb(136, 55, 250); font-size: 23px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="UpgradeValueRow" style="min-height: 34px; flex-direction: row; align-items: center; top: -16px;">
                <ui:Label text="10" name="CurrentValueLabel" style="color: rgb(135, 97, 236); font-size: 24px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;);"/>
                <ui:VisualElement name="ValueArrow" picking-mode="Ignore" style="width: 22px; height: 22px; margin-left: 7px; margin-right: 7px; background-image: resource(&quot;UI/Shopping popup/upgrade arrow&quot;); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(94, 255, 117);"/>
                <ui:Label text="20" name="NextValueLabel" style="color: rgb(88, 255, 112); font-size: 24px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;);"/>
            </ui:VisualElement>
            <ui:Label text="upgrade.base_health.details" name="UpgradeDescriptionLabel" style="max-width: 420px; color: rgb(135, 97, 236); font-size: 20px; white-space: normal; overflow: visible; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-font-style: bold; width: 420px; height: 31px; top: -19px;"/>
        </ui:VisualElement>
        <ui:Button name="BuyUpgradeButton" style="width: 200px; height: 100px; flex-shrink: 0; padding-top: 8px; padding-right: 12px; padding-bottom: 8px; padding-left: 12px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(0, 0, 0, 0); background-image: resource(&quot;UI/new/ItemFrame01_Single_Blue&quot;); -unity-background-scale-mode: stretch-to-fill; align-items: center; justify-content: center; -unity-slice-left: 35; -unity-slice-top: 35; -unity-slice-right: 35; -unity-slice-bottom: 35; flex-direction: column;">
            <ui:Label text="base.upgrade_buy" name="BuyLabel" picking-mode="Ignore" style="color: rgb(255, 255, 255); -unity-text-outline-color: rgb(34, 39, 83); -unity-text-outline-width: 2px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 24px; -unity-text-align: middle-center;"/>
            <ui:VisualElement name="PriceRow" picking-mode="Ignore" style="flex-direction: row; align-items: center; width: auto; height: auto; top: -15px;">
                <ui:Label text="250" name="PriceLabel" style="color: rgb(255, 255, 255); -unity-text-outline-color: rgb(34, 39, 83); -unity-text-outline-width: 2px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); font-size: 26px; -unity-text-align: middle-right;"/>
                <ui:VisualElement name="PriceIcon" style="width: 31px; height: 31px; margin-left: 5px; background-image: resource(&quot;UI/new/Icons/Icon_Gold&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            </ui:VisualElement>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
