<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Layout" style="flex-grow: 1; justify-content: center;">
        <ui:VisualElement name="ShopPanel" style="flex-grow: 1; background-image: resource(&quot;UI/new/CardFrame08_White&quot;); -unity-background-scale-mode: stretch-to-fill; width: 600px; min-width: 600px; max-width: 600px; align-self: center; justify-content: flex-start; height: 900px; min-height: 900px; max-height: 900px; align-items: center; -unity-slice-left: 30; -unity-slice-top: 30; -unity-slice-right: 30; -unity-slice-bottom: 30; -unity-background-image-tint-color: rgb(238, 223, 60);">
            <ui:Label text="settings.title" name="TitleLabel" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; width: 368px; height: 107px; top: 6px; left: -16px; -unity-text-align: middle-center; font-size: 50px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); color: rgb(255, 255, 255);"/>
            <ui:Button text="&#10;" name="CloseButton" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); background-image: resource(&quot;UI/new/Buttons/Button_Square03_White&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; width: 100px; min-width: 100px; max-width: 100px; height: 100px; min-height: 100px; max-height: 100px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-background-image-tint-color: rgb(241, 69, 69); position: absolute; top: -25px; left: 512px;">
                <ui:VisualElement name="CloseIcon" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icons/Icon_PictoIcon_Close&quot;); width: 75px; min-width: 75px; max-width: 75px; height: 75px; min-height: 75px; max-height: 75px;"/>
            </ui:Button>
            <ui:VisualElement name="SettingsPanel" style="flex-grow: 1; height: 430px; min-height: 430px; max-height: 430px; width: 700px; min-width: 700px; max-width: 700px; top: auto;">
                <ui:VisualElement name="MusicPanel" style="flex-grow: 1; width: 100%; height: 115px; min-height: 115px; max-height: 115px; flex-direction: row; justify-content: center; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; align-self: center;">
                    <ui:Label text="settings.music" name="MusicLabel" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; -unity-text-align: middle-left; font-size: 35px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;);"/>
                    <ui:Button name="MusicButton" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); height: 100px; min-height: 100px; max-height: 100px; width: 100px; min-width: 100px; max-width: 100px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); background-image: resource(&quot;UI/new/Buttons/Button_Square03_White&quot;); left: 0; -unity-slice-left: 25; -unity-slice-top: 25; -unity-slice-right: 25; -unity-slice-bottom: 25; -unity-background-image-tint-color: rgb(248, 153, 153);">
                        <ui:VisualElement name="Icon" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icons/Icon_PictoIcon_Sound_on&quot;); -unity-background-scale-mode: stretch-to-fill;"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="SoundPanel" style="flex-grow: 1; width: 100%; height: 115px; min-height: 115px; max-height: 115px; flex-direction: row; justify-content: center; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; align-self: center;">
                    <ui:Label text="settings.sound" name="SoundLabel" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; -unity-text-align: middle-left; font-size: 35px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;);"/>
                    <ui:Button name="SoundButton" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); height: 100px; min-height: 100px; max-height: 100px; width: 100px; min-width: 100px; max-width: 100px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); background-image: resource(&quot;UI/new/Buttons/Button_Square03_White&quot;); top: 0; left: 20px; -unity-slice-left: 25; -unity-slice-top: 25; -unity-slice-right: 25; -unity-slice-bottom: 25; -unity-background-image-tint-color: rgb(248, 141, 141);">
                        <ui:VisualElement name="Icon" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icons/Icon_PictoIcon_Sound_off&quot;);"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="LanguagePanel" style="flex-grow: 1; width: 100%; height: 200px; min-height: 200px; max-height: 200px; flex-direction: column; justify-content: center; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; align-self: center;">
                    <ui:Label text="settings.language" name="LanguageLabel" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; -unity-text-align: upper-center; font-size: 35px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); height: 50px; min-height: 50px; max-height: 50px; width: 100%; min-width: 100%; max-width: 100%;"/>
                    <ui:VisualElement name="LanguagePanel" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: center;">
                        <ui:Button name="RuLanguageButton" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 100px; min-width: 100px; max-width: 100px; height: 100px; min-height: 100px; max-height: 100px; background-image: resource(&quot;UI/LanguageFlags/flag_ru&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                        <ui:Button name="EnLanguageButton" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); width: 100px; min-width: 100px; max-width: 100px; height: 100px; min-height: 100px; max-height: 100px; background-image: resource(&quot;UI/LanguageFlags/flag_en&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="GoToMenuButton" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); background-image: resource(&quot;UI/new/ItemFrame01_Single_Red&quot;); background-color: rgba(188, 188, 188, 0); -unity-background-image-tint-color: rgb(255, 255, 255); width: 350px; height: 150px; top: 0; left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-self: center; -unity-slice-left: 30; -unity-slice-top: 30; -unity-slice-right: 30; -unity-slice-bottom: 30; margin-bottom: 25px;">
                    <ui:Label text="settings.go_to_menu" name="GoToMenuButtonLabel" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; height: 74px; top: 12px; left: 15px; width: 290px; font-size: 35px; white-space: normal; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;);"/>
                </ui:Button>
                <ui:Button name="ResetProgressButton" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); background-image: resource(&quot;UI/new/ItemFrame01_Single_Red&quot;); background-color: rgba(188, 188, 188, 0); -unity-background-image-tint-color: rgb(255, 255, 255); width: 350px; height: 150px; top: 0; left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-self: center; -unity-slice-left: 30; -unity-slice-top: 30; -unity-slice-right: 30; -unity-slice-bottom: 30;">
                    <ui:Label text="settings.reset_progress" name="ResetProgressButtonLabel" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; height: 74px; top: 12px; left: 15px; width: 290px; font-size: 35px; white-space: normal; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;);"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
