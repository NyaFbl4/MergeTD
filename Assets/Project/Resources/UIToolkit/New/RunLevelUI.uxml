                        <ui:VisualElement name="TowerIcon" style="flex-grow: 1; background-image: resource(&quot;Guns/Gun01/Idle/Gun01-Idle_0&quot;); width: 100px; height: 120px; min-height: 120px; max-height: 120px; min-width: 100px; max-width: 100px; position: absolute; top: 12px; left: auto; -unity-slice-type: sliced; rotate: 0 1 1 0; -unity-background-scale-mode: scale-to-fit;"/>
                        <ui:Label text="СПЕЛЫ" name="SetSpellsLabel" style="position: relative; height: 78px; width: 171px; left: 0; -unity-text-align: middle-center; font-size: 50px; -unity-font-style: bold; top: 80px; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;); text-overflow: clip; white-space: nowrap; -unity-text-auto-size: best-fit 10px 100px;"/>
                    </ui:Button>
                    <ui:Button name="PayTowerButton" style="background-image: resource(&quot;UI/new/ItemFrame01_Single_Green&quot;); background-color: rgba(255, 255, 255, 0); width: 180px; height: 180px; -unity-background-scale-mode: stretch-to-fill; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; min-height: 180px; max-height: 180px; top: 20px; left: 0; min-width: 180px; max-width: 180px; background-position-x: left 0; background-position-y: center; -unity-slice-left: 15; -unity-slice-top: 15; -unity-slice-right: 15; -unity-slice-bottom: 15; flex-direction: column; margin-right: 10px; margin-left: 10px; align-items: center;">
                        <ui:VisualElement name="VisualElement" focusable="true" style="flex-grow: 1; background-image: resource(&quot;Guns/Shield&quot;); width: 46px; height: 44px; position: absolute; top: 10px; left: 10px;">
                            <ui:Label text="10" name="TowerLeveLabel" style="height: 100%; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 22px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;);"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="TowerIcon" style="flex-grow: 1; background-image: resource(&quot;Guns/Gun01/Idle/Gun01-Idle_0&quot;); width: 100px; height: 120px; min-height: 120px; max-height: 120px; min-width: 100px; max-width: 100px; position: absolute; top: 12px; left: auto; -unity-slice-type: sliced; rotate: 0 1 1 0; -unity-background-scale-mode: scale-to-fit;"/>
                        <ui:Label text="5000" name="PayTowerLabel" style="position: relative; height: 78px; width: 171px; left: 0; -unity-text-align: middle-center; font-size: 50px; -unity-font-style: bold; top: 80px; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;);"/>
                    </ui:Button>
                    <ui:Button name="PayElectricTowerButton" style="background-image: resource(&quot;UI/new/ItemFrame01_Single_Blue&quot;); background-color: rgba(255, 255, 255, 0); width: 180px; height: 180px; -unity-background-scale-mode: stretch-to-fill; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; min-height: 180px; max-height: 180px; top: 20px; left: 0; min-width: 180px; max-width: 180px; background-position-x: left 0; background-position-y: center; -unity-slice-left: 15; -unity-slice-top: 15; -unity-slice-right: 15; -unity-slice-bottom: 15; flex-direction: column; margin-left: 10px; margin-right: 10px; align-items: center;">
                        <ui:VisualElement name="VisualElement" focusable="true" style="flex-grow: 1; background-image: resource(&quot;Guns/Shield&quot;); width: 46px; height: 44px; position: absolute; top: 10px; left: 10px;">
                            <ui:Label text="10" name="TowerLeveLabel" style="height: 100%; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 22px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;);"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="TowerIcon" style="flex-grow: 1; background-image: resource(&quot;Guns/Generator/Idle/Generator01-Idle_2&quot;); width: 100px; height: 120px; min-height: 120px; max-height: 120px; min-width: 100px; max-width: 100px; position: absolute; top: 12px; left: auto; -unity-slice-type: sliced; rotate: 0 1 1 0; -unity-background-scale-mode: scale-to-fit;"/>
                        <ui:Label text="5000" name="PayTowerLabel" style="position: relative; height: 78px; width: 171px; left: 0; -unity-text-align: middle-center; font-size: 50px; -unity-font-style: bold; top: 80px; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;);"/>
                    </ui:Button>
                    <ui:Button name="SetTowersButton" style="background-image: resource(&quot;UI/new/ItemFrame01_Single_Red&quot;); background-color: rgba(255, 255, 255, 0); width: 180px; height: 180px; -unity-background-scale-mode: stretch-to-fill; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; min-height: 180px; max-height: 180px; top: 20px; left: 0; min-width: 180px; max-width: 180px; background-position-x: left 0; background-position-y: center; -unity-slice-left: 15; -unity-slice-top: 15; -unity-slice-right: 15; -unity-slice-bottom: 15; flex-direction: column; margin-right: 10px; margin-left: 10px; align-items: center;">
                        <ui:VisualElement name="TowerIcon" style="flex-grow: 1; background-image: resource(&quot;Guns/Gun01/Idle/Gun01-Idle_0&quot;); width: 100px; height: 120px; min-height: 120px; max-height: 120px; min-width: 100px; max-width: 100px; position: absolute; top: 12px; left: auto; -unity-slice-type: sliced; rotate: 0 1 1 0; -unity-background-scale-mode: scale-to-fit; background-position-y: center;"/>
                        <ui:Label text="БАШНИ" name="SetTowersLaberl" style="position: relative; height: 78px; width: 171px; left: 0; -unity-text-align: middle-center; font-size: 50px; -unity-font-style: bold; top: 80px; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;);"/>
                    </ui:Button>
