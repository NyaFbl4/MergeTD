        <ui:VisualElement name="BotPanel" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 300px; min-height: 300px; max-height: 300px; bottom: 0; position: absolute; top: auto; left: 0; flex-direction: column; justify-content: center;">
