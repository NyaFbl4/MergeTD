<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="SpellButton" src="project://database/Assets/Project/Resources/UIToolkit/New/SpellButton.uxml?fileID=9197481963319205126&amp;guid=290c677105eae334abb1a2452ac79b4e&amp;type=3#SpellButton"/>
    <ui:VisualElement name="Layout" picking-mode="Ignore" style="flex-grow: 1; left: auto; background-position-x: center;">
        <ui:VisualElement name="TopPanel" picking-mode="Ignore" style="flex-grow: 1; height: 300px; min-height: 300px; max-height: 300px; flex-direction: row;">
            <ui:VisualElement name="ResourcesBar" style="flex-grow: 1; background-image: none; -unity-background-scale-mode: scale-to-fit; height: 100px; min-height: 100px; max-height: 100px; width: 300px; min-width: 300px; max-width: 300px; top: 20px; left: 20px;">
                <ui:VisualElement name="GoldBar" style="flex-grow: 1; flex-direction: row; align-items: center; width: 300px; height: 100px; min-height: 100px; max-height: 100px; min-width: 300px; max-width: 300px;">
                    <ui:VisualElement name="GoldIcon" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icon_Gold&quot;); width: 75px; height: 75px; min-height: 75px; max-height: 75px; min-width: 75px; max-width: 75px;"/>
                    <ui:Label text="222.22k" name="GoldLabel" style="height: 71px; width: 206px; left: auto; top: auto; -unity-text-align: middle-left; font-size: 50px; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="GemBar" style="flex-grow: 1; flex-direction: row; align-items: center; width: 300px; height: 100px; min-height: 100px; max-height: 100px; min-width: 300px; max-width: 300px;">
                    <ui:VisualElement name="GemIcon" style="flex-grow: 1; background-image: resource(&quot;UI/new/Icon_Gem03_Diamond_Purple 1&quot;); width: 75px; height: 75px; min-height: 75px; max-height: 75px; min-width: 75px; max-width: 75px; -unity-background-scale-mode: scale-to-fit;"/>
                    <ui:Label text="222.22k" name="GemLabel" style="height: 71px; width: 206px; left: auto; top: auto; -unity-text-align: middle-left; font-size: 50px; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="WevePanel" style="flex-grow: 1;">
                <ui:Label text="WAVE 5" name="WaveLabel" style="-unity-text-align: middle-center; font-size: 50px; height: 119px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&amp;guid=4beb055f07aaff244873dec698d0363e&amp;type=3#Roboto-Bold&quot;);"/>
            </ui:VisualElement>
            <ui:Button name="SettingsButton" style="background-image: resource(&quot;UI/game play area Ui/settings&quot;); background-color: rgba(255, 255, 255, 0); width: 100px; height: 100px; -unity-background-scale-mode: stretch-to-fill; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; min-height: 100px; max-height: 100px; top: 20px; left: -23px; min-width: 100px; max-width: 100px; background-position-x: left 0; background-position-y: center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="HealthBar" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row; height: 100px; min-height: 100px; max-height: 100px; -unity-text-align: upper-left; justify-content: center; top: 788px;">
            <ui:Label text="50" name="CurrentBaseHealthLabel" style="font-size: 50px; -unity-text-align: upper-right; width: 200px; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;);"/>
            <ui:Label text="/" name="Label" style="font-size: 50px; -unity-font-definition: resource(&quot;Fonts/Alfa_Slab_One/AlfaSlabOne-Regular&quot;);"/>
