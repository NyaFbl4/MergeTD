            <ui:VisualElement name="StateWave" style="flex-grow: 1; display: none;">
                <ui:VisualElement name="EnergyProgressBar" style="flex-grow: 1; justify-content: flex-end; align-self: center;">
                    <ui:VisualElement name="ProgressBarBackground" style="flex-grow: 1; width: 800px; min-width: 800px; max-width: 800px; height: 50px; min-height: 50px; max-height: 50px; background-image: resource(&quot;UI/new/Slider_Basic02_Bg&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; background-color: rgba(36, 35, 147, 0); -unity-background-image-tint-color: rgba(36, 35, 147, 0.784);">
                        <ui:VisualElement name="ProgressBarFill" style="flex-grow: 1; background-image: resource(&quot;UI/new/Slider_Basic02_Bg&quot;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; background-size: 100% 100%; background-position-x: center; background-position-y: center; -unity-background-scale-mode: stretch-to-fill; width: 75%; height: 95%; min-height: 95%; max-height: 95%; top: 1px; -unity-background-image-tint-color: rgba(0, 204, 255, 0.784);"/>
                        <ui:VisualElement name="TextPanel" style="flex-grow: 1; height: 50px; width: 100%; top: auto; position: absolute; flex-direction: row; justify-content: center;">
                            <ui:Label text="10.5" name="CurrentEnergyLabel" style="font-size: 25px; -unity-text-align: upper-right;"/>
                            <ui:Label text="/" name="" style="font-size: 25px; -unity-text-align: upper-right;"/>
                            <ui:Label text="12" name="MaxEnergyLabel" style="font-size: 25px; -unity-text-align: upper-right;"/>
                        </ui:VisualElement>
