<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="AcceleratorOfferCard" style="width: 218px; height: 410px; flex-shrink: 0; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
        <ui:VisualElement name="CardBackground" picking-mode="Ignore" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-image: resource(&quot;UI/new/CardFrame08_Single_Blue&quot;); -unity-slice-left: 40; -unity-slice-top: 40; -unity-slice-right: 40; -unity-slice-bottom: 40;"/>
        <ui:VisualElement name="BonusBadge" picking-mode="Ignore" style="position: absolute; top: -12px; right: -9px; min-width: 76px; height: 38px; padding-right: 10px; padding-left: 10px; justify-content: center; background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); -unity-slice-left: 25; -unity-slice-top: 25; -unity-slice-right: 25; -unity-slice-bottom: 25; -unity-background-image-tint-color: rgb(245, 218, 40);">
            <ui:Label name="BonusLabel" text="1 в день" style="color: rgb(49, 35, 22); font-size: 20px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center;"/>
        </ui:VisualElement>
        <ui:Label name="TitleLabel" text="Ускоритель" style="position: absolute; top: 20px; left: 12px; right: 12px; height: 48px; white-space: normal; color: white; font-size: 23px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-outline-color: black; -unity-text-outline-width: 1px; -unity-text-align: middle-center;"/>
        <ui:VisualElement name="AcceleratorIcons" picking-mode="Ignore" style="position: absolute; top: 72px; left: 28px; width: 162px; height: 108px;">
            <ui:VisualElement name="AcceleratorIconSecondary" picking-mode="Ignore" style="display: none; position: absolute; left: 0; top: 18px; width: 96px; height: 96px; background-image: resource(&quot;UI/new/Icons/Icon_Stopwatch&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            <ui:VisualElement name="AcceleratorIconTertiary" picking-mode="Ignore" style="display: none; position: absolute; left: 66px; top: 18px; width: 96px; height: 96px; background-image: resource(&quot;UI/new/Icons/Icon_Stopwatch&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            <ui:VisualElement name="AcceleratorIconPrimary" picking-mode="Ignore" style="position: absolute; left: 25px; top: 0; width: 112px; height: 112px; background-image: resource(&quot;UI/new/Icons/Icon_Stopwatch&quot;); -unity-background-scale-mode: scale-to-fit;"/>
        </ui:VisualElement>
        <ui:Label name="AmountLabel" text="+1" style="position: absolute; top: 185px; left: 12px; right: 12px; height: 48px; color: white; font-size: 46px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-outline-color: black; -unity-text-outline-width: 2px; -unity-text-align: middle-center;"/>
        <ui:Label name="LimitLabel" text="Доступно: 1/1" style="position: absolute; top: 235px; left: 12px; right: 12px; height: 22px; color: white; font-size: 17px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-outline-color: black; -unity-text-outline-width: 1px; -unity-text-align: middle-center;"/>
        <ui:Label name="TimerLabel" text="" style="position: absolute; top: 257px; left: 12px; right: 12px; height: 38px; white-space: normal; color: white; font-size: 16px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-outline-color: black; -unity-text-outline-width: 1px; -unity-text-align: middle-center;"/>
        <ui:Label name="StatusLabel" text="" style="position: absolute; top: 295px; left: 12px; right: 12px; height: 34px; white-space: normal; color: rgb(255, 239, 184); font-size: 16px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-outline-color: black; -unity-text-outline-width: 1px; -unity-text-align: middle-center;"/>
        <ui:Button name="BuyButton" style="position: absolute; bottom: 18px; left: 17px; right: 17px; height: 58px; flex-direction: row; align-items: center; justify-content: center; padding-top: 0; padding-right: 4px; padding-bottom: 0; padding-left: 4px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(0, 0, 0, 0); background-image: resource(&quot;UI/new/BorderFrame_Round03&quot;); -unity-slice-left: 30; -unity-slice-top: 30; -unity-slice-right: 30; -unity-slice-bottom: 30; -unity-background-image-tint-color: rgb(39, 192, 46);">
            <ui:VisualElement name="PriceIcon" picking-mode="Ignore" style="width: 34px; height: 34px; flex-shrink: 0; margin-right: 4px; background-image: resource(&quot;UI/new/Icons/Icon_ImageIcon_Ad_00_l&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            <ui:Label name="PriceLabel" text="Смотреть" picking-mode="Ignore" style="font-size: 25px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center; color: white; -unity-text-outline-color: black; -unity-text-outline-width: 1px;"/>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
