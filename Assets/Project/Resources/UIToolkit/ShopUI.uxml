<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="ShopUI.uss" />
    <ui:Template name="UpgradeObjectUI" src="project://database/Assets/Project/Resources/UIToolkit/UpgradeObjectUI.uxml?fileID=9197481963319205126&amp;guid=dd6c192b898b622479b350ca8ec3dd60&amp;type=3#UpgradeObjectUI" />
    <ui:VisualElement name="Layout" style="flex-grow: 1; justify-content: center;">
        <ui:VisualElement name="Backgound" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: resource(&apos;UI/Shopping popup/dark background&apos;); display: flex;" />
        <ui:VisualElement name="ShopPanel" style="flex-grow: 1; background-image: resource(&apos;UI/Shopping popup/store box bg&apos;); -unity-background-scale-mode: stretch-to-fill; width: 1000px; min-width: 1000px; max-width: 1000px; align-self: center; justify-content: flex-start; height: 1200px; min-height: 1200px; max-height: 1200px; align-items: center;">
            <ui:Label text="shop.title" name="TitleLabel" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; width: 431px; height: 105px; top: 6px; left: -16px; -unity-text-align: middle-center; font-size: 50px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); color: rgb(255, 255, 255);" />
            <ui:Button name="CloseButton" style="-unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); background-color: rgba(188, 188, 188, 0); background-image: resource(&apos;UI/Shopping popup/close btn pressed&apos;); -unity-background-image-tint-color: rgb(183, 255, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 120px; min-width: 120px; max-width: 120px; height: 120px; min-height: 120px; max-height: 120px; top: -113px; left: 485px;" />
            <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" name="ScrollView" style="width: 950px; height: 950px; top: -70px;">
                <ui:VisualElement name="OfferPanel">
                    <ui:Label text="Предложения" name="OfferLabel" style="font-size: 48px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center;" />
                    <ui:VisualElement name="OfferContainer" style="align-items: center;" />
                </ui:VisualElement>
                <ui:VisualElement name="EnergyOffersPanel">
                    <ui:Label text="shop.energy_tab" name="EnergySectionLabel" style="font-size: 48px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center;" />
                    <ui:VisualElement name="EnergyContainer" style="width: 720px; min-width: 720px; max-width: 720px; align-self: center; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; align-content: flex-start;" />
                </ui:VisualElement>
                <ui:VisualElement name="AcceleratorOffersPanel">
                    <ui:Label text="shop.accelerators.title" name="AcceleratorSectionLabel" style="font-size: 48px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center;" />
                    <ui:VisualElement name="AcceleratorContainer" style="width: 720px; min-width: 720px; max-width: 720px; align-self: center; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; align-content: flex-start;" />
                </ui:VisualElement>
                <ui:VisualElement name="GemPanel">
                    <ui:Label text="Гемы" name="GemLabel" style="font-size: 48px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center;" />
                    <ui:VisualElement name="GemContainer" class="shop-offer-grid" style="width: 720px; min-width: 720px; max-width: 720px; align-self: center; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; align-content: flex-start;" />
                </ui:VisualElement>
                <ui:VisualElement name="GoldPanel">
                    <ui:Label text="shop.gold_tab" name="GoldSectionLabel" style="font-size: 48px; -unity-font-definition: resource(&quot;Fonts/Lilita One Regular&quot;); -unity-text-align: middle-center;"/>
                    <ui:VisualElement name="GoldContainer" class="shop-offer-grid" style="width: 720px; min-width: 720px; max-width: 720px; align-self: center; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; align-content: flex-start;"/>
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:Label name="EmptyLabel" class="shop-empty-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
